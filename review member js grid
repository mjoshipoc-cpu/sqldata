from st_aggrid import AgGrid, GridOptionsBuilder, JsCode


edit_button_renderer = JsCode('''
    class EditBtnCellRenderer {
        init(params) {
            this.params = params;
            this.eGui = document.createElement('div');
            
            // --- Center the button in the cell
            this.eGui.style.display = "flex";
            this.eGui.style.justifyContent = "center";
            this.eGui.style.alignItems = "center";
            
            this.eGui.innerHTML = `
             <span>
                <style>
                .btn_edit {
                  background-color: #007bff;
                  border: none;
                  color: white;
                  display: flex;
                  align-items: center;   /* vertical centering inside button */
                  justify-content: center; /* horizontal centering inside button */
                  font-size: 12px;
                  font-weight: bold;
                  height: 2.5em;
                  width: 6em;
                  cursor: pointer;
                  border-radius: 6px;
                  margin: 2px;
                  line-height: normal;
                  padding: 0;
                  transition: background-color 0.2s ease-in-out;
                }
                .btn_edit:hover {
                  background-color: #0056b3;
                }
                </style>
                <button class="btn_edit">Edit</button>
             </span>
          `;
          const btn = this.eGui.querySelector('button');
          btn.addEventListener('click', () => {
              try {
                  this.params.node.setDataValue('__action__', 'edit');
              } catch (e) { console.error(e); }
          });
        }
        getGui() {
            return this.eGui;
        }
    };
''')


